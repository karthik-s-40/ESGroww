generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hospital {
  id                    String               @id @default(cuid())
  hospitalName          String
  industry              String               @default("Healthcare")
  builtUpArea           Float                @default(0)
  numberOfBeds          Int                  @default(0)
  createdAt             DateTime             @default(now())
  accountStatus         String               @default("Pending Verification")
  averageDailyOccupancy Int                  @default(0)
  country               String               @default("India")
  numberOfEmployees     Int                  @default(0)
  numberOfFloors        Int                  @default(0)
  operatingHours        Float                @default(24)
  sectorCode            String               @default("HOSP")
  state                 String               @default("")
  updatedAt             DateTime             @updatedAt
  yearEstablished       Int                  @default(2020)
  assessmentCycles      AssessmentCycle[]
  assessmentHistory     AssessmentHistory[]
  calculatedMetrics     CalculatedMetric[]
  certificationScores   CertificationScore[]
  dataUploadBatches     DataUploadBatch[]
  esgScores             ESGScore[]
  electricityData       ElectricityData[]
  emissionsSummary      EmissionsSummary[]
  fuelData              FuelData[]
  governanceData        GovernanceData?
  refrigerantData       RefrigerantData[]
  transportData         TransportData[]
  uploads               Upload[]
  users                 User[]
  validationResults     ValidationResult[]
  wasteData             WasteData[]
  waterData             WaterData[]
}

model User {
  id                      String    @id @default(cuid())
  fullName                String
  email                   String    @unique
  password                String
  role                    String    @default("hospital_admin")
  hospitalId              String
  emailVerified           Boolean   @default(false)
  emailVerificationToken  String?
  emailVerificationExpiry DateTime?
  resetPasswordToken      String?
  resetPasswordExpiry     DateTime?
  failedLoginAttempts     Int       @default(0)
  accountLockedUntil      DateTime?
  lastLoginAt             DateTime?
  lastLoginIp             String?
  rememberMeEnabled       Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  hospital                Hospital  @relation(fields: [hospitalId], references: [id])
}

model AssessmentCycle {
  id                  String               @id @default(cuid())
  hospitalId          String
  name                String
  startDate           DateTime?
  endDate             DateTime?
  isLocked            Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  hospital            Hospital             @relation(fields: [hospitalId], references: [id])
  assessmentHistory   AssessmentHistory[]
  calculatedMetrics   CalculatedMetric[]
  certificationScores CertificationScore[]
  dataUploadBatches   DataUploadBatch[]
  esgScores           ESGScore[]
  electricityData     ElectricityData[]
  emissionsSummary    EmissionsSummary[]
  fuelData            FuelData[]
  refrigerantData     RefrigerantData[]
  transportData       TransportData[]
  uploads             Upload[]
  validationResults   ValidationResult[]
  wasteData           WasteData[]
  waterData           WaterData[]

  @@index([hospitalId])
}

/// Enterprise audit record for each accepted Excel ingestion (supports incremental + merge strategies).
model DataUploadBatch {
  id                  String            @id @default(cuid())
  hospitalId          String
  category            String
  sourceFileName      String
  fileContentHash     String
  batchVersion        Int
  resolutionStrategy  String?
  distinctMonthCount  Int
  rowCount            Int
  monthKeysCsv        String?
  isSuperseded        Boolean           @default(false)
  supersededAt        DateTime?
  supersededByBatchId String?
  createdAt           DateTime          @default(now())
  assessmentCycleId   String?
  assessmentCycle     AssessmentCycle?  @relation(fields: [assessmentCycleId], references: [id], onDelete: Cascade)
  hospital            Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  electricityRows     ElectricityData[]
  fuelRows            FuelData[]
  refrigerantRows     RefrigerantData[]
  transportRows       TransportData[]
  uploadRecord        Upload?
  wasteRows           WasteData[]
  waterRows           WaterData[]

  @@index([hospitalId, category, createdAt])
  @@index([hospitalId, category, fileContentHash])
  @@index([assessmentCycleId])
}

model ElectricityData {
  id                String           @id @default(cuid())
  hospitalId        String
  month             String
  year              Int
  electricityKwh    Float            @default(0)
  renewableKwh      Float            @default(0)
  createdAt         DateTime         @default(now())
  sourceBatchId     String?
  assessmentCycleId String?
  assessmentCycle   AssessmentCycle? @relation(fields: [assessmentCycleId], references: [id], onDelete: Cascade)
  hospital          Hospital         @relation(fields: [hospitalId], references: [id])
  dataUploadBatch   DataUploadBatch? @relation(fields: [sourceBatchId], references: [id])

  @@unique([hospitalId, month, year, assessmentCycleId])
}

model WaterData {
  id                String           @id @default(cuid())
  hospitalId        String
  month             String
  year              Int
  waterKl           Float            @default(0)
  recycledWaterKl   Float            @default(0)
  createdAt         DateTime         @default(now())
  sourceBatchId     String?
  assessmentCycleId String?
  assessmentCycle   AssessmentCycle? @relation(fields: [assessmentCycleId], references: [id], onDelete: Cascade)
  hospital          Hospital         @relation(fields: [hospitalId], references: [id])
  dataUploadBatch   DataUploadBatch? @relation(fields: [sourceBatchId], references: [id])

  @@unique([hospitalId, month, year, assessmentCycleId])
}

model FuelData {
  id                String           @id @default(cuid())
  hospitalId        String
  month             String
  year              Int
  dgDieselLitres    Float            @default(0)
  createdAt         DateTime         @default(now())
  sourceBatchId     String?
  assessmentCycleId String?
  assessmentCycle   AssessmentCycle? @relation(fields: [assessmentCycleId], references: [id], onDelete: Cascade)
  hospital          Hospital         @relation(fields: [hospitalId], references: [id])
  dataUploadBatch   DataUploadBatch? @relation(fields: [sourceBatchId], references: [id])

  @@unique([hospitalId, month, year, assessmentCycleId])
}

model WasteData {
  id                String           @id @default(cuid())
  hospitalId        String
  month             String
  year              Int
  biomedicalWasteKg Float            @default(0)
  recyclableWasteKg Float            @default(0)
  landfillWasteKg   Float            @default(0)
  createdAt         DateTime         @default(now())
  sourceBatchId     String?
  assessmentCycleId String?
  assessmentCycle   AssessmentCycle? @relation(fields: [assessmentCycleId], references: [id], onDelete: Cascade)
  hospital          Hospital         @relation(fields: [hospitalId], references: [id])
  dataUploadBatch   DataUploadBatch? @relation(fields: [sourceBatchId], references: [id])

  @@unique([hospitalId, month, year, assessmentCycleId])
}

model RefrigerantData {
  id                String           @id @default(cuid())
  hospitalId        String
  month             String
  year              Int
  refrigerantType   String
  refrigerantLeakKg Float            @default(0)
  createdAt         DateTime         @default(now())
  sourceBatchId     String?
  assessmentCycleId String?
  assessmentCycle   AssessmentCycle? @relation(fields: [assessmentCycleId], references: [id], onDelete: Cascade)
  hospital          Hospital         @relation(fields: [hospitalId], references: [id])
  dataUploadBatch   DataUploadBatch? @relation(fields: [sourceBatchId], references: [id])

  @@unique([hospitalId, month, year, refrigerantType, assessmentCycleId])
}

model TransportData {
  id                  String           @id @default(cuid())
  hospitalId          String
  month               String
  year                Int
  ambulanceFuelLitres Float            @default(0)
  staffCommuteKm      Float            @default(0)
  createdAt           DateTime         @default(now())
  sourceBatchId       String?
  assessmentCycleId   String?
  assessmentCycle     AssessmentCycle? @relation(fields: [assessmentCycleId], references: [id], onDelete: Cascade)
  hospital            Hospital         @relation(fields: [hospitalId], references: [id])
  dataUploadBatch     DataUploadBatch? @relation(fields: [sourceBatchId], references: [id])

  @@unique([hospitalId, month, year, assessmentCycleId])
}

model GovernanceData {
  id                         String   @id @default(cuid())
  hospitalId                 String   @unique
  hasEsgPolicy               Boolean  @default(false)
  hasSustainabilityCommittee Boolean  @default(false)
  hasAuditReports            Boolean  @default(false)
  hasComplianceDocs          Boolean  @default(false)
  createdAt                  DateTime @default(now())
  hospital                   Hospital @relation(fields: [hospitalId], references: [id])
}

model Upload {
  id                 String           @id @default(cuid())
  hospitalId         String
  category           String
  fileUrl            String
  month              String
  year               Int
  createdAt          DateTime         @default(now())
  fileContentHash    String?
  isReplaced         Boolean          @default(false)
  replacedAt         DateTime?
  resolutionStrategy String?
  rowCount           Int?
  sourceFile         String?
  /// Same as `DataUploadBatch.id` when this row represents a batch ingestion.
  uploadBatchId      String?          @unique
  uploadedAt         DateTime         @default(now())
  /// Monotonic batch sequence for this hospital + category (audit).
  version            Int              @default(1)
  assessmentCycleId  String?
  assessmentCycle    AssessmentCycle? @relation(fields: [assessmentCycleId], references: [id], onDelete: Cascade)
  hospital           Hospital         @relation(fields: [hospitalId], references: [id])
  uploadBatch        DataUploadBatch? @relation(fields: [uploadBatchId], references: [id])

  @@index([hospitalId, category, createdAt])
  @@index([assessmentCycleId])
}

model ESGScore {
  id                String           @id @default(cuid())
  hospitalId        String
  overallScore      Float
  energyScore       Float
  waterScore        Float
  wasteScore        Float
  governanceScore   Float
  emissionsScore    Float
  createdAt         DateTime         @default(now())
  assessmentCycleId String?
  assessmentCycle   AssessmentCycle? @relation(fields: [assessmentCycleId], references: [id], onDelete: Cascade)
  hospital          Hospital         @relation(fields: [hospitalId], references: [id])
}

model AssessmentHistory {
  id                     String           @id @default(cuid())
  hospitalId             String
  createdAt              DateTime         @default(now())
  completenessPct        Float?
  confidenceScore        Float?
  annualizedValues       Json?
  benchmarkScores        Json?
  certificationReadiness Json?
  gapAnalysis            Json?
  readinessStage         String?
  assessmentCycleId      String?
  assessmentCycle        AssessmentCycle? @relation(fields: [assessmentCycleId], references: [id], onDelete: Cascade)
  hospital               Hospital         @relation(fields: [hospitalId], references: [id])

  @@index([hospitalId])
  @@index([assessmentCycleId])
}

model ValidationResult {
  id                String           @id @default(cuid())
  hospitalId        String
  category          String
  checkType         String
  status            String
  affectedMonth     String?
  affectedYear      Int?
  notes             String?
  createdAt         DateTime         @default(now())
  assessmentCycleId String?
  assessmentCycle   AssessmentCycle? @relation(fields: [assessmentCycleId], references: [id], onDelete: Cascade)
  hospital          Hospital         @relation(fields: [hospitalId], references: [id])
}

model CertificationScore {
  id                   String           @id @default(cuid())
  hospitalId           String
  certificationName    String
  readinessPercent     Float
  statusLabel          String
  majorGap             String?
  recommendedTimeline  String?
  prerequisitesMetJson Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  assessmentCycleId    String?
  assessmentCycle      AssessmentCycle? @relation(fields: [assessmentCycleId], references: [id], onDelete: Cascade)
  hospital             Hospital         @relation(fields: [hospitalId], references: [id])
}

model CalculatedMetric {
  id                 String           @id @default(cuid())
  hospitalId         String
  metricName         String
  rawValue           Float?
  annualizedValue    Float?
  unit               String
  confidenceModifier Float            @default(1.0)
  benchmarkStatus    String?
  createdAt          DateTime         @default(now())
  assessmentCycleId  String?
  assessmentCycle    AssessmentCycle? @relation(fields: [assessmentCycleId], references: [id], onDelete: Cascade)
  hospital           Hospital         @relation(fields: [hospitalId], references: [id])
}

model EmissionsSummary {
  id                String           @id @default(cuid())
  hospitalId        String
  scope             String
  source            String
  kgCO2e            Float
  tCO2e             Float
  factorUsed        String?
  createdAt         DateTime         @default(now())
  assessmentCycleId String?
  assessmentCycle   AssessmentCycle? @relation(fields: [assessmentCycleId], references: [id], onDelete: Cascade)
  hospital          Hospital         @relation(fields: [hospitalId], references: [id])
}

model CertificationApplicability {
  id                String @id @default(cuid())
  sectorCode        String
  certificationName String
  importanceLevel   String

  @@unique([sectorCode, certificationName])
}

model BenchmarkMaster {
  id            String @id @default(cuid())
  sectorCode    String
  metricName    String
  efficientMax  Float
  acceptableMin Float
  acceptableMax Float
  unit          String

  @@unique([sectorCode, metricName])
}

model EmissionFactor {
  id              String   @id @default(cuid())
  sourceType      String
  region          String   @default("India")
  factorValue     Float
  unit            String
  overrideAllowed Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([sourceType, region])
}

model ConfidenceThreshold {
  id              String @id @default(cuid())
  monthsMin       Int
  monthsMax       Int
  modifier        Float
  confidenceLabel String

  @@unique([monthsMin, monthsMax])
}

/// Append-only record of admin configuration changes (and optional future actions).
model AdminAuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType])
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

model ScoringWeight {
  id          String   @id @default(cuid())
  category    String   @unique
  weightValue Float
  updatedAt   DateTime @updatedAt
}

model CertificationCutoff {
  id                String   @id @default(cuid())
  certificationName String   @unique
  minCompleteness   Float?
  minConfidence     Float?
  minGovernance     Float?
  minRenewable      Float?
  minWaterRecycled  Float?
  minWasteDiversion Float?
  minEnergyScore    Float?
  updatedAt         DateTime @updatedAt
}

model AnnualizationModifier {
  id           String   @id @default(cuid())
  monthsMin    Int
  monthsMax    Int
  modifierRate Float
  updatedAt    DateTime @updatedAt

  @@unique([monthsMin, monthsMax])
}

model KpiRange {
  id           String   @id @default(cuid())
  metricName   String   @unique
  excellentMax Float
  goodMax      Float
  fairMax      Float
  updatedAt    DateTime @updatedAt
}

model RiskThreshold {
  id             String   @id @default(cuid())
  regulationName String   @unique
  lowRiskMin     Float
  mediumRiskMin  Float
  updatedAt      DateTime @updatedAt
}
